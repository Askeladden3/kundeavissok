<?php
require_once __DIR__ . '/vendor/autoload.php';

use Dotenv\Dotenv;

// 1. Load the .env file from the current directory
try {
    $dotenv = Dotenv::createImmutable(__DIR__);
    $dotenv->load();
} catch (Exception $e) {
    http_response_code(500);
    echo json_encode(['error' => '.env file missing or unreadable.']);
    exit();
}

// 2. Extract MySQL credentials from .env
$host = $_ENV['DB_HOST'] ?? 'localhost';
$db   = $_ENV['DB_NAME'] ?? '';
$user = $_ENV['DB_USER'] ?? '';
$pass = $_ENV['DB_PASS'] ?? '';

// ===================================================
//  Enable CORS
// ===================================================
$allowed_origins = [
    'https://kuso.fuhr.no',
    'https://www.kuso.fuhr.no',
];

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if (in_array($origin, $allowed_origins)) {
    header("Access-Control-Allow-Origin: $origin");
    header("Access-Control-Allow-Methods: GET, POST, OPTIONS");
    header("Access-Control-Allow-Headers: Content-Type");
}

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit();
}

header('Content-Type: application/json');

// 3. Connect to MySQL
try {
    $dsn = "mysql:host=$host;dbname=$db;charset=utf8mb4";
    $conn = new PDO($dsn, $user, $pass);
    $conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
} catch (PDOException $e) {
    http_response_code(500);
    echo json_encode(['error' => 'MySQL connection failed: ' . $e->getMessage()]);
    exit();
}

// --- Input Processing ---
$query = isset($_GET['q']) ? trim($_GET['q']) : '';
$dealType = isset($_GET['type']) ? trim($_GET['type']) : '';
$storesFilter = isset($_GET['stores']) ? trim($_GET['stores']) : '';
$categoryFilter = isset($_GET['category']) ? trim($_GET['category']) : '';
$proteinFilter = isset($_GET['protein_type']) ? trim($_GET['protein_type']) : '';

/**
 * FULL-TEXT SEARCH PROCESSING
 * We use Boolean Mode so we can append '*' for partial matching.
 * If the query is empty, we set it to a dummy value that won't filter anything, 
 * or we handle the SQL logic below.
 */
$searchParam = !empty($query) ? $query . '*' : '';

// Stores Clause
$storeClause = '';
$storeParams = [];
if (!empty($storesFilter)) {
    $storeList = array_filter(array_map('trim', explode(',', $storesFilter)), function($v){ return $v !== ''; });
    if (!empty($storeList)) {
        $placeholders = implode(',', array_fill(0, count($storeList), '?'));
        $storeClause = " AND store IN ($placeholders)";
        $storeParams = array_values($storeList);
    }
}

// Category Clause
$catClause = '';
$catParams = [];
if (!empty($categoryFilter)) {
    $catClause = " AND category = ?";
    $catParams[] = $categoryFilter;
}

// Protein Clause
$protClause = '';
$protParams = [];
if (!empty($proteinFilter) && $categoryFilter === 'meat') {
    $protClause = " AND protein_type = ?";
    $protParams[] = $proteinFilter;
}

// Full-Text Search Logic: If query is empty, we match everything (1=1)
$matchClause = !empty($query) ? "MATCH(name) AGAINST(? IN BOOLEAN MODE)" : "1=1";

try {
    $params = [];
    $sql = '';

    if ($dealType === 'salg') {
        $sql = "
            SELECT 
                id, name, percentage_off, 
                NULL as total_price, NULL as price_per_unit, total_mass, unit,
                store, page_number, brand, category, protein_type
            FROM percentage_deal 
            WHERE {$matchClause} {$storeClause} {$catClause} {$protClause}

            UNION ALL

            SELECT 
                id, name, NULL as percentage_off, 
                total_price, price_per_unit, total_mass, unit,
                store, page_number, brand, category, protein_type
            FROM standard_deal 
            WHERE {$matchClause} {$storeClause} {$catClause} {$protClause}

            ORDER BY price_per_unit ASC
        ";

        // Params for first SELECT
        if (!empty($query)) { $params[] = $searchParam; }
        $params = array_merge($params, $storeParams, $catParams, $protParams);
        
        // Params for second SELECT
        if (!empty($query)) { $params[] = $searchParam; }
        $params = array_merge($params, $storeParams, $catParams, $protParams);

    } elseif ($dealType === 'bogo') {
        $sql = "
            SELECT 
                id, name, items_received, items_paid_for, 
                total_mass, unit, store, page_number, brand, category, protein_type
            FROM bogo_deal 
            WHERE {$matchClause} {$storeClause} {$catClause} {$protClause}
            ORDER BY name ASC
        ";

        if (!empty($query)) { $params[] = $searchParam; }
        $params = array_merge($params, $storeParams, $catParams, $protParams);

    } else {
        http_response_code(400);
        echo json_encode(['error' => "Invalid deal type: $dealType"]);
        exit();
    }

    $stmt = $conn->prepare($sql);
    $stmt->execute($params);
    $results = $stmt->fetchAll(PDO::FETCH_ASSOC);

    echo json_encode($results);

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode(['error' => 'Query failed: ' . $e->getMessage()]);
} finally {
    $conn = null;
}
?>