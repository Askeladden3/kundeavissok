<?php

// ===================================================
//  Enable CORS
// ===================================================
$allowed_origins = [
    'https://kuso.fuhr.no',
    'https://www.kuso.fuhr.no',
];

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if (in_array($origin, $allowed_origins)) {
    header("Access-Control-Allow-Origin: $origin");
    header("Access-Control-Allow-Methods: GET, POST, OPTIONS");
    header("Access-Control-Allow-Headers: Content-Type");
}

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit();
}

header('Content-Type: application/json');
$databaseFile = __DIR__ . "/databaser/kundeavis_{{search_uke}}.db";

if (!file_exists($databaseFile)) {
    http_response_code(500);
    echo json_encode(['error' => 'Database file not found.']);
    exit();
}

try {
    $conn = new PDO('sqlite:' . $databaseFile);
    $conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
} catch (PDOException $e) {
    http_response_code(500);
    echo json_encode(['error' => 'Database connection failed: ' . $e->getMessage()]);
    exit();
}

// --- Input Processing ---
$query = isset($_GET['q']) ? trim($_GET['q']) : '';
$dealType = isset($_GET['type']) ? trim($_GET['type']) : '';
$storesFilter = isset($_GET['stores']) ? trim($_GET['stores']) : '';
$categoryFilter = isset($_GET['category']) ? trim($_GET['category']) : '';
$proteinFilter = isset($_GET['protein_type']) ? trim($_GET['protein_type']) : '';


$searchParam = "%" . $query . "%";

// Stores Clause
$storeClause = '';
$storeParams = [];
if (!empty($storesFilter)) {
    $storeList = array_filter(array_map('trim', explode(',', $storesFilter)), function($v){ return $v !== ''; });
    if (!empty($storeList)) {
        $placeholders = implode(',', array_fill(0, count($storeList), '?'));
        $storeClause = " AND store IN ($placeholders)";
        $storeParams = array_values($storeList);
    }
}

// Category Clause
$catClause = '';
$catParams = [];
if (!empty($categoryFilter)) {
    $catClause = " AND category = ?";
    $catParams[] = $categoryFilter;
}

// Protein Clause (Only apply if category is 'meat' now)
$protClause = '';
$protParams = [];
if (!empty($proteinFilter) && $categoryFilter === 'meat') {
    $protClause = " AND protein_type = ?";
    $protParams[] = $proteinFilter;
}

try {
    $params = [];
    $sql = '';

    // MATCHING THE NEW FRONTEND: 'salg' and 'bogo'
    if ($dealType === 'salg') {
        $sql = "
            SELECT 
                id, name, percentage_off, 
                NULL as total_price, NULL as price_per_unit, total_mass, unit,
                store, page_number, brand, category, protein_type
            FROM percentage_deal 
            WHERE name LIKE ? {$storeClause} {$catClause} {$protClause}

            UNION ALL

            SELECT 
                id, name, NULL as percentage_off, 
                total_price, price_per_unit, total_mass, unit,
                store, page_number, brand, category, protein_type
            FROM standard_deal 
            WHERE name LIKE ? {$storeClause} {$catClause} {$protClause}

            ORDER BY price_per_unit ASC
        ";

        // Params for first SELECT statement in UNION
        $params[] = $searchParam;
        if (!empty($storeParams)) { $params = array_merge($params, $storeParams); }
        if (!empty($catParams))   { $params = array_merge($params, $catParams); }
        if (!empty($protParams))  { $params = array_merge($params, $protParams); }
        
        // Params for second SELECT statement in UNION (must duplicate them)
        $params[] = $searchParam;
        if (!empty($storeParams)) { $params = array_merge($params, $storeParams); }
        if (!empty($catParams))   { $params = array_merge($params, $catParams); }
        if (!empty($protParams))  { $params = array_merge($params, $protParams); }

    } elseif ($dealType === 'bogo') {
        $sql = "
            SELECT 
                id, name, items_received, items_paid_for, 
                total_mass, unit, store, page_number, brand, category, protein_type
            FROM bogo_deal 
            WHERE name LIKE ? {$storeClause} {$catClause} {$protClause}
            ORDER BY name ASC
        ";

        $params[] = $searchParam;
        if (!empty($storeParams)) { $params = array_merge($params, $storeParams); }
        if (!empty($catParams))   { $params = array_merge($params, $catParams); }
        if (!empty($protParams))  { $params = array_merge($params, $protParams); }

    } else {
        http_response_code(400);
        echo json_encode(['error' => "Invalid deal type specified: $dealType"]);
        exit();
    }

    $stmt = $conn->prepare($sql);
    $stmt->execute($params);
    $results = $stmt->fetchAll(PDO::FETCH_ASSOC);

    echo json_encode($results);

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode(['error' => 'Search failed: ' . $e->getMessage()]);
} finally {
    $conn = null;
}
?>